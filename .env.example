# Copy to .env and fill in. See auth_config.md for where each value comes from.

# OAuth 2.0 Client ID (type "Web application") from Google Cloud Console.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Signs the session cookie. At least 32 characters. Generate one with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
SESSION_SECRET=

# The URL players open, without a trailing slash. Must match the authorized
# JavaScript origin in Google Cloud; the redirect URI is this + /auth/callback.
PUBLIC_BASE_URL=http://localhost:8080

# Set to 1 when the site is served over HTTPS.
COOKIE_SECURE=0

# Host port for the web container (docker compose only).
WEB_PORT=8080
